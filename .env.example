# Copiar a .env en la raíz del repo:
#   Windows:  copy .env.example .env
#   Linux/macOS: cp .env.example .env
# docker compose lee este archivo automáticamente. No subas .env al repositorio.

# --- PostgreSQL (obligatorio para docker compose) ---
POSTGRES_USER=rimai_user
POSTGRES_PASSWORD=rimai_secure_2026
POSTGRES_DB=rimai_db
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# pgAdmin (solo con: docker compose --profile dev up -d)
PGADMIN_EMAIL=admin@rimai.local
PGADMIN_PASSWORD=rimai_pgadmin_2026

# --- Backend FastAPI ---
# Obligatorio. En producción genere otro valor: openssl rand -hex 32
JWT_SECRET=cambia_este_secreto_local_con_openssl_rand_hex_32

# Usado si corre el backend fuera de Docker (uvicorn local).
# Dentro de Docker, docker-compose.yml arma DATABASE_URL con el host "db".
DATABASE_URL=postgresql://rimai_user:rimai_secure_2026@localhost:5432/rimai_db

# Obligatorio. Orígenes del navegador separados por coma.
# Incluye emulador Android (10.0.2.2) y Flutter web/desktop en localhost.
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:8000,http://10.0.2.2:8000,http://localhost:5000,http://127.0.0.1:5000
# Permite Flutter web en Chrome (puerto aleatorio). Vacío en producción.
CORS_ORIGIN_REGEX=https?://(localhost|127\.0\.0\.1)(:\d+)?

# Registro público de familias (true en desarrollo)
ALLOW_PUBLIC_REGISTER=true

# Rate limiting de auth (true en producción; false solo en tests)
RATE_LIMIT_ENABLED=true

# Pool de conexiones PostgreSQL (opcional)
DB_POOL_MIN=2
DB_POOL_MAX=10

# Evaluar alertas clínicas en cada GET /api/dashboard/resumen (default: false)
EVALUAR_ALERTAS_EN_RESUMEN=false

# Directorio de archivos de evaluación (opcional; hay default en código)
# RIMAI_UPLOAD_DIR=./uploads/evaluations

# Solo para pytest local
# RIMAI_ALLOW_TEST_DEFAULTS=1
